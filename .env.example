# === LLM ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-08-06
OPENAI_TRIAGE_MODEL=gpt-4o-mini-2024-07-18
LLM_BACKEND=openai
# Air-gap alternative: set LLM_BACKEND=vllm and VLLM_BASE_URL=http://localhost:8004/v1

# === Storage ===
DB_URL=sqlite:///./data/tenderaudit.db
STORAGE_BACKEND=local
BLOB_DIR=./data/blobs
# Production alternative:
# DB_URL=postgresql://app:app@localhost:5433/app
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=localhost:9002
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=tenderaudit

# === API ===
API_PORT=8001
CORS_ALLOW_ORIGINS=http://localhost:3001

# === RAG / Embeddings ===
RAG_FALLBACK_LOCAL=0
# Set RAG_FALLBACK_LOCAL=1 to use chromadb local embeddings (no OpenAI needed)

# === Signing / Certificates ===
SIGNING_CERT_DIR=./data/certs

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8001

# === Project ===
PROJECT_NAME=tenderaudit
